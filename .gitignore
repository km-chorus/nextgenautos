# Secrets and local configuration
.env
.env.*
!.env.example
app/config/*.local.php

# Dependencies
vendor/
node_modules/

# Uploaded media (keep the directories and the execution-protection file)
uploads/*
!uploads/.htaccess
!uploads/vehicles/
uploads/vehicles/*
!uploads/vehicles/.gitkeep
!uploads/team/
uploads/team/*
!uploads/team/.gitkeep
!uploads/parts/
uploads/parts/*
!uploads/parts/.gitkeep

# Logs and cache
logs/
cache/
# Short-lived private data (password reset cache, 2026-10-22): never committed; the folder carries its own deny file
storage/*
!storage/.htaccess
*.log
# cPanel PHP error files (no extension)
error_log

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
