# Copy to .env (git-ignored) and fill in locally. Never commit real values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=AmponsahAutos
DB_USER=
DB_PASSWORD=

# development (local, plain http://localhost works) or production (HTTPS required). Unset = production.
APP_ENV=development
# Optional: admin inactivity timeout in seconds (default 1800 = 30 minutes).
# Values under 300 are only honored when APP_ENV=development (for testing).
# SESSION_TIMEOUT_SECONDS=1800

# Encryption key for two-factor secrets. Generate with: php database/generate_app_key.php
# SECRET: never commit a real value; back it up (losing it disables existing 2FA enrollments).
APP_KEY=
# Public address of the site, used for links in emails. Production must be https.
APP_URL=http://localhost:8000
# Password reset lifetime in minutes (default 30; allowed 5 to 120).
# PASSWORD_RESET_MINUTES=30
# Email delivery through Brevo (server-side only; never put these in JavaScript or Git).
# Until these are set, "Forgot password?" says plainly that email is not configured.
# MAIL_MAILER=smtp uses the Brevo SMTP relay (PHPMailer, STARTTLS on port 587). In Brevo: SMTP & API > SMTP gives the
# login (ends with @smtp-brevo.com) and lets you generate an SMTP key (the password). MAIL_FROM_ADDRESS must be a
# sender verified in Brevo (Senders, domains & dedicated IPs). Test with: php database/send_test_email.php --check
MAIL_MAILER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Next Gen Autos and Parts
# Alternative transport: MAIL_MAILER=brevo_api with an API key (SMTP & API > API keys).
BREVO_API_KEY=
# Customer "Continue with Google" (server-side only; never put these in JavaScript or Git).
# Create an OAuth 2.0 Web client in Google Cloud Console and register EXACTLY this redirect URI there:
#   <APP_URL>/auth/google/callback/      e.g. http://localhost:8000/auth/google/callback/
# Until both values are set, the Google buttons are simply not shown.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
