# Uploaded files must never be executed as code.
# Only static image files are served from this directory.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|html?|js)$">
    Require all denied
</FilesMatch>

Options -ExecCGI -Indexes
